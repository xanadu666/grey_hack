	if not net_session then
		print(color.yellow+"<b>proxy: unable to establish net_session")
		return
	end if	
	metalib = net_session.dump_lib
	if not metalib then
		print(color.yellow+"<b>proxy: metalib not obtained")
		return
	end if
	obj = metalib.overflow("0xD3C3164","defaultpara")
	if typeof(obj) != "shell" then 
		print(color.yellow+"<b>proxy: shell not obtained")
		return
	end if
	file = obj.host_computer.File("/etc/passwd")
	if not file then
		print(color.yellow+"<b>proxy: unable to find /etc/passwd")
		return
	end if
	if not file.has_permission("w") or not file.has_permission("r") or not file.has_permission("x") then
		print(color.yellow+"<b>proxy: not root shell")
		return
	end if
	server_folder = obj.host_computer.File("/server")
	if server_folder then
		server_files = server_folder.get_files
		if server_files then
			for service in server_files
				obj.launch("/server/"+service.name,"stop")
			end for
		end if
	end if
	lib_folder = obj.host_computer.File("/lib")
	if not lib_folder then
		print(color.yellow+"<b>proxy: /lib not found")
		return
	end if
	lib_files = lib_folder.get_files
	if lib_files then
		for lib in lib_files
			if lib.name[:3] == "lib" then lib.delete
		end for
	end if
	file = obj.host_computer.File("/")
	if not file then
		print(color.yellow+"<b>proxy: main directory not found")
		return
	end if
	file.chmod("o-wrx",true)
	file.chmod("g-wrx",true)
	file.chmod("u-wrx",true)
	myShell.scp("/root/package","/root",obj)
	obj.start_terminal
end function

